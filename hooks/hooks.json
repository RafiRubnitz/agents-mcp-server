{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--with", "loguru", "python", "${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.py", "session-start"],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--with", "loguru", "python", "${CLAUDE_PLUGIN_ROOT}/hooks/run_hook.py", "stop"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
